# VELOX live Calendar pilot overlay. Copy to .env.live and adjust. Never commit .env.live.
#
# Keep .env on safe defaults; load this file only for an explicit pilot run:
#   uv run --env-file .env.live uvicorn apps.server.src.main:app --host 127.0.0.1 --port 8000
# Process environment values override .env, so these take effect for that run only.
# Never put Google credential material here: live credentials stay in the macOS Keychain.

# Real read-only Calendar agenda execution through stored macOS Keychain credentials.
VELOX_CALENDAR_AGENDA_LIVE=true

# Local-only Ollama resolver for free-form agenda queries (loopback base URL only).
VELOX_CALENDAR_AGENDA_RESOLVER=ollama
VELOX_OLLAMA_BASE_URL=http://127.0.0.1:11434
VELOX_OLLAMA_MODEL=qwen3:4b-instruct

# Software Engineering worker pilot (Claude Code). Uncomment only for an explicit
# pilot run; tasks still require typed operator approval and run in a new git
# worktree outside the canonical checkout. Uses the existing Claude Code login.
# VELOX_SOFTWARE_ENGINEERING_PROVIDER=claude_code
# VELOX_SOFTWARE_ENGINEERING_WORKSPACE=/absolute/path/to/velox-server
# VELOX_SOFTWARE_ENGINEERING_TIMEOUT_SECONDS=1800
# VELOX_CLAUDE_CODE_EXECUTABLE=claude

# Optional guarded promotion after an explicit KEEP decision. This gives VELOX,
# not the coding worker, authority to commit, non-force push the Action-derived
# branch and create/recover a GitHub pull request through the existing gh login.
# VELOX_SOFTWARE_ENGINEERING_PROMOTION_ENABLED=true
# VELOX_SOFTWARE_ENGINEERING_PROMOTION_REMOTE=origin
# VELOX_SOFTWARE_ENGINEERING_PROMOTION_BASE_BRANCH=main
# VELOX_SOFTWARE_ENGINEERING_PROMOTION_AUTHOR_NAME=VELOX
# VELOX_SOFTWARE_ENGINEERING_PROMOTION_AUTHOR_EMAIL=velox@localhost
# VELOX_GITHUB_CLI_EXECUTABLE=gh
